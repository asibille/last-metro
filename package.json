{
  "name": "lastmetro-api",
  "version": "1.0.0",
  "description": "API pour savoir si tu peux attraper le dernier métro",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "preinstall": "npx npm-force-resolutions"
  },
  "keywords": [
    "metro",
    "paris",
    "api"
  ],
  "author": "sibille",
  "license": "MIT",
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "npm-force-resolutions": "^0.0.10",
    "supertest": "^7.1.4"
  },
  "resolutions": {
    "cross-spawn": "^7.0.5",
    "glob": "^11.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
